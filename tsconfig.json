{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"],
        "allowJs": true
    },
    "include": [
        "src",
        "shared",
        "electron",
        "backend",
        "gateway",
        "scripts",
        "tests",
        "*.ts",
        "*.mts"
    ]
}

# INERT REVIEW CANDIDATE: outside workflows/, non-YAML suffix, and job-level false guard.
# Copying/renaming or removing the guard requires diagnostic execution admission.
# Vite custody does not admit the existing default Git timeout or file/publication adapters.
# The CLI has no default native capability: enabling this template alone cannot admit execution.
name: Held diagnostic web build and same-run inspection
on:
    push:
        branches: [ci/web-build-diagnostic-96a56cd-20261105]
permissions:
    contents: read
jobs:
    web_archive:
        if: ${{ false }}
        runs-on: ubuntu-24.04
        timeout-minutes: 20
        steps:
            - name: Refuse an unsupported runner, rerun, source branch or event before any setup
              shell: bash
              run: |
                  set -euo pipefail
                  test "$GITHUB_REPOSITORY" = brucerry/embedded-linux-diagnostic-hub
                  test "${{ github.event.repository.private }}" = false
                  test "$GITHUB_EVENT_NAME" = push
                  test "$GITHUB_REF" = refs/heads/ci/web-build-diagnostic-96a56cd-20261105
                  test "$GITHUB_RUN_ATTEMPT" = 1
                  test "${RUNNER_ENVIRONMENT:-}" = github-hosted
                  test "$RUNNER_OS" = Linux
                  test "$RUNNER_ARCH" = X64
                  test "$(id -u)" != 0
            - uses: actions/checkout@v6
              with:
                  ref: ${{ github.sha }}
                  fetch-depth: 0
                  persist-credentials: false
                  clean: false
                  set-safe-directory: false
                  submodules: false
                  lfs: false
            - uses: actions/setup-node@v7
              with:
                  node-version: '24.22.0'
                  package-manager-cache: false
            - name: Prepare the separately admitted installed toolchain
              run: npm ci --ignore-scripts --no-audit --no-fund --registry=https://registry.npmjs.org
              env:
                  ELECTRON_SKIP_BINARY_DOWNLOAD: '1'
            - name: Select exact source and fresh producer directory
              id: selected
              run: |
                  test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
                  mkdir -p validation
                  node --input-type=module <<'NODE' >> "$GITHUB_OUTPUT"
                  import fs from 'node:fs';
                  const { version } = JSON.parse(fs.readFileSync('package.json', 'utf8'));
                  if (!/^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-[A-Za-z0-9.-]+)?$/.test(version) || version.length > 160) throw Error('Invalid version');
                  console.log('version=' + version);
                  NODE
                  printf 'tree=%s\n' "$(git rev-parse HEAD^{tree})" >> "$GITHUB_OUTPUT"
            - name: Produce source-bound shipping ZIP and bounded build record
              id: producer
              env:
                  SELECTED_VERSION: ${{ steps.selected.outputs.version }}
                  SELECTED_TREE: ${{ steps.selected.outputs.tree }}
              run: |
                  node scripts/produce-web-archive.mjs \
                    --scope=web \
                    --version="$SELECTED_VERSION" \
                    --source-commit="$GITHUB_SHA" \
                    --source-tree="$SELECTED_TREE" \
                    --run-id="$GITHUB_RUN_ID" \
                    --run-attempt="$GITHUB_RUN_ATTEMPT" \
                    --job-key="$GITHUB_JOB" \
                    --output=validation/web-source
            - name: Inspect the archive in this same run and emit only the bounded diagnostic receipt
              if: ${{ success() && steps.producer.outcome == 'success' }}
              env:
                  SELECTED_VERSION: ${{ steps.selected.outputs.version }}
                  SELECTED_TREE: ${{ steps.selected.outputs.tree }}
              run: |
                  node --input-type=module <<'NODE'
                  import assert from 'node:assert/strict';
                  import * as fs from 'node:fs/promises';
                  import { readStableArtifactFile } from './scripts/lib/web-archive-producer.mjs';
                  import { inspectDiagnosticWebBuild } from './scripts/lib/diagnostic-web-inspection.mjs';
                  assert.equal(process.env.RUNNER_ENVIRONMENT, 'github-hosted');
                  assert.equal(process.env.GITHUB_RUN_ATTEMPT, '1');
                  const root = await fs.realpath('validation/web-source');
                  const name = 'Diagnostic-Hub-Web-' + process.env.SELECTED_VERSION + '.zip';
                  const record = (await readStableArtifactFile(root, 'web-build.json', 16 * 1024 ** 2, fs)).bytes;
                  const archive = (await readStableArtifactFile(root, name, 128 * 1024 ** 2, fs)).bytes;
                  const checksum = (await readStableArtifactFile(root, name + '.sha256', 1024, fs)).bytes;
                  const expected = { scope: 'web', version: process.env.SELECTED_VERSION,
                    sourceCommit: process.env.GITHUB_SHA, sourceTree: process.env.SELECTED_TREE,
                    runId: process.env.GITHUB_RUN_ID, runAttempt: process.env.GITHUB_RUN_ATTEMPT,
                    jobKey: process.env.GITHUB_JOB };
                  const { bytes } = inspectDiagnosticWebBuild(record, archive, checksum, expected,
                    { completed: true, exitCode: 0, signal: null, timedOut: false });
                  process.stdout.write('HUB_DIAGNOSTIC_WEB_RECEIPT=' + bytes.toString('utf8'));
                  NODE
# No artifact/cache upload, browser/server launch, attestation/signing, release consumer or release.
# Default producer remains intentionally blocked: source-owned native capability is not supplied.
# Do not treat this inactive template as execution-ready by just removing its false guard.
